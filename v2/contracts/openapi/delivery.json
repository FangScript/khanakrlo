{
  "openapi": "3.1.0",
  "info": { "title": "Delivery service API", "version": "1.0.0", "description": "Rider dispatch, delivery transitions, and active-order location tracking." },
  "servers": [{ "url": "/v1/delivery", "description": "API gateway" }],
  "paths": {
    "/rider/availability": { "put": { "operationId": "setRiderAvailability", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["available"], "properties": { "available": { "type": "boolean" } }, "additionalProperties": false } } } }, "responses": { "200": { "description": "Availability updated" }, "409": { "description": "Rider has an active assignment" } } } },
    "/rider/location": { "put": { "operationId": "updateRiderLocation", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["latitude", "longitude"], "properties": { "latitude": { "type": "number", "minimum": -90, "maximum": 90 }, "longitude": { "type": "number", "minimum": -180, "maximum": 180 } }, "additionalProperties": false } } } }, "responses": { "204": { "description": "Location updated during active delivery" }, "403": { "description": "No active delivery permits location updates" } } } },
    "/rider/offers": { "get": { "operationId": "listRiderOffers", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Ready delivery offers" } } } },
    "/rider/deliveries/{orderId}/accept": { "post": { "operationId": "acceptDelivery", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "COD-authorized assignment" }, "409": { "description": "Offer unavailable or cash custody blocks assignment" } } } },
    "/rider/deliveries/{orderId}/transitions": { "post": { "operationId": "transitionDelivery", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["toStatus"], "properties": { "toStatus": { "enum": ["picked_up", "delivered"] } }, "additionalProperties": false } } } }, "responses": { "200": { "description": "Delivery state updated" }, "409": { "description": "Transition or COD collection is invalid" } } } },
    "/orders/{orderId}/tracking": { "get": { "operationId": "getOrderTracking", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "responses": { "200": { "description": "Active tracking with stale-location indicator" }, "404": { "description": "Caller is not a permitted order participant" } } } }
  },
  "components": { "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } } }
}
