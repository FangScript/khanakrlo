{
  "openapi": "3.1.0",
  "info": { "title": "Order service API", "version": "1.0.0", "description": "Server-priced COD orders with immutable menu and delivery address snapshots." },
  "servers": [{ "url": "/v1/order", "description": "API gateway" }],
  "paths": {
    "/orders/quote": {
      "post": { "operationId": "quoteOrder", "security": [{ "bearerAuth": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderInput" } } } }, "responses": { "200": { "description": "Current server-calculated total" }, "400": { "$ref": "#/components/responses/BadRequest" }, "409": { "description": "Restaurant or selected menu item is unavailable" }, "503": { "description": "Required service or financial configuration is unavailable" } } }
    },
    "/orders": {
      "post": { "operationId": "placeOrder", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 16, "maxLength": 128 } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderInput" } } } }, "responses": { "201": { "description": "Created order and immutable price snapshot" }, "409": { "description": "Idempotency conflict or items unavailable" }, "422": { "description": "Order is outside supported total limits" } } }
    },
    "/orders/mine": {
      "get": { "operationId": "listMyOrders", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Customer orders belonging to the authenticated user" } } }
    },
    "/merchant/orders": {
      "get": { "operationId": "listKitchenOrders", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "KDS orders for outlets owned by the authenticated merchant" } } }
    },
    "/orders/{orderId}/transitions": {
      "post": { "operationId": "transitionOrder", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "orderId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["toStatus"], "properties": { "toStatus": { "type": "string", "enum": ["accepted","rejected","preparing","ready","cancelled"] } }, "additionalProperties": false } } } }, "responses": { "200": { "description": "Order transitioned with versioned event" }, "403": { "description": "Actor is not an order customer or outlet merchant" }, "404": { "description": "Order not found" }, "409": { "description": "Invalid state transition" } } }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "schemas": {
      "OrderInput": { "type": "object", "required": ["outletId","addressId","paymentMethod","items"], "properties": { "outletId": { "type": "string", "format": "uuid" }, "addressId": { "type": "string", "format": "uuid" }, "paymentMethod": { "const": "cod" }, "items": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "object", "required": ["menuItemId","quantity","modifierIds"], "properties": { "menuItemId": { "type": "string", "format": "uuid" }, "quantity": { "type": "integer", "minimum": 1, "maximum": 50 }, "modifierIds": { "type": "array", "items": { "type": "string", "format": "uuid" } } }, "additionalProperties": false } } }, "additionalProperties": false },
      "Error": { "type": "object", "required": ["error","message"], "properties": { "error": { "type": "string" }, "message": { "type": "string" } } }
    },
    "responses": { "BadRequest": { "description": "Request is invalid", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } } }
  }
}
