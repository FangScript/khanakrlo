{
  "openapi":"3.1.0",
  "info":{"title":"Notification service API","version":"1.0.0","description":"In-app customer notifications and device registration."},
  "servers":[{"url":"/v1/notification","description":"API gateway"}],
  "paths":{
    "/notifications/mine":{"get":{"operationId":"listMyNotifications","security":[{"bearerAuth":[]}],"parameters":[{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100}}],"responses":{"200":{"description":"Notifications for the authenticated customer"}}}},
    "/notifications/{notificationId}/read":{"post":{"operationId":"markNotificationRead","security":[{"bearerAuth":[]}],"parameters":[{"name":"notificationId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"responses":{"200":{"description":"Notification marked read"},"404":{"description":"Notification not owned by this user"}}}},
    "/notifications/device":{"put":{"operationId":"registerNotificationDevice","security":[{"bearerAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["token","platform"],"properties":{"token":{"type":"string","minLength":32,"maxLength":4096},"platform":{"enum":["android","ios"]}},"additionalProperties":false}}}},"responses":{"204":{"description":"Device token hash registered"}}}}
  },
  "components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"JWT"}}}
}
