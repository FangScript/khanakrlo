{
  "openapi": "3.1.0",
  "info": {
    "title": "Restaurant service API",
    "version": "1.0.0",
    "description": "Self-service merchant onboarding and restaurant-owned outlet availability. No admin approval is required to create an account."
  },
  "servers": [{ "url": "/v1/restaurant", "description": "API gateway" }],
  "paths": {
    "/onboarding": {
      "post": {
        "operationId": "onboardRestaurant",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string", "minLength": 16, "maxLength": 128 } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Onboarding" } } } },
        "responses": {
          "201": { "description": "Active restaurant and outlet; order availability starts disabled", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OnboardingResult" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "503": { "$ref": "#/components/responses/DependencyUnavailable" }
        }
      }
    },
    "/mine": {
      "get": {
        "operationId": "listMyRestaurants",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Restaurants and outlets owned by the authenticated merchant" }, "401": { "$ref": "#/components/responses/Unauthorized" } }
      }
    },
    "/outlets/{outletId}/availability": {
      "patch": {
        "operationId": "setOutletAvailability",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "outletId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["acceptingOrders"], "properties": { "acceptingOrders": { "type": "boolean" } }, "additionalProperties": false } } } },
        "responses": { "200": { "description": "Outlet availability updated" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "404": { "description": "Outlet not found or not owned by this merchant" } }
      }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } },
    "schemas": {
      "Onboarding": {
        "type": "object",
        "required": ["businessName", "cuisine", "outletName", "city", "addressLine"],
        "properties": {
          "businessName": { "type": "string", "minLength": 2, "maxLength": 120 },
          "cuisine": { "type": "string", "minLength": 2, "maxLength": 80 },
          "outletName": { "type": "string", "minLength": 2, "maxLength": 120 },
          "city": { "type": "string", "minLength": 2, "maxLength": 80 },
          "addressLine": { "type": "string", "minLength": 5, "maxLength": 500 }
        },
        "additionalProperties": false
      },
      "OnboardingResult": {
        "type": "object",
        "required": ["organisationId", "outletId", "status", "acceptingOrders"],
        "properties": {
          "organisationId": { "type": "string", "format": "uuid" },
          "outletId": { "type": "string", "format": "uuid" },
          "status": { "const": "active" },
          "acceptingOrders": { "const": false }
        },
        "additionalProperties": false
      },
      "Error": { "type": "object", "required": ["error", "message"], "properties": { "error": { "type": "string" }, "message": { "type": "string" } } }
    },
    "responses": {
      "Unauthorized": { "description": "A valid session is required", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "BadRequest": { "description": "Request fields are invalid", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "DependencyUnavailable": { "description": "Identity could not grant the merchant workspace yet; retry with the same idempotency key", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  }
}
