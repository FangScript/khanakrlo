{
  "openapi": "3.1.0",
  "info": {
    "title": "Customer service API",
    "version": "1.0.0",
    "description": "Customer-owned profiles, masked consented phone, addresses and versioned cart. Implemented endpoints; prices are never accepted from cart clients."
  },
  "servers": [
    {
      "url": "/v1/customer",
      "description": "Gateway"
    },
    {
      "url": "/v1",
      "description": "Direct service"
    }
  ],
