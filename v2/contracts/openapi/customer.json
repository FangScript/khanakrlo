  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Profile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "phone",
          "phoneConsentAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "phoneConsentAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "ProfileUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "displayName"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "PhoneConsent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phone",
          "consent"
        ],
        "properties": {
          "phone": {
            "type": "string",
            "pattern": "^\\+[1-9]\\d{7,14}$",
            "example": "+923001234567"
          },
          "consent": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "MaskedPhone": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phone",
          "phoneConsentAt"
        ],
        "properties": {
          "phone": {
            "type": "string",
            "example": "+\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u20224567"
          },
          "phoneConsentAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AddressInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "addressLine",
          "latitude",
          "longitude"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "addressLine": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        }
      },
      "CartItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "menuItemId",
          "quantity",
          "modifierIds"
        ],
        "properties": {
          "menuItemId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "modifierIds": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "CartUpdate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outletId",
          "version",
          "items"
        ],
        "properties": {
          "outletId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483646
          },
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/CartItem"
            }
          }
        }
      },
      "Cart": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outletId",
          "version",
          "items"
        ],
        "properties": {
          "outletId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/CartItem"
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Address": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "addressLine",
          "latitude",
          "longitude"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "addressLine": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          }
        }
      },
      "Addresses": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Address"
            }
          }
        }
      }
    }
  }
}
