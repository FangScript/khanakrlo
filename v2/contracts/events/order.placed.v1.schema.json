{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.khanakarlo.local/events/order.placed.v1.schema.json",
  "title": "Order placed event v1",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    { "type": "object", "properties": {
      "type": { "const": "order.placed" },
      "version": { "const": 1 },
      "producer": { "const": "order" },
      "payload": { "type": "object", "required": ["orderId", "customerId", "outletId", "addressId", "items", "totalPaisa", "commissionPaisa", "currency", "paymentMethod"], "properties": {
        "orderId": { "type": "string", "format": "uuid" },
        "customerId": { "type": "string", "format": "uuid" },
        "outletId": { "type": "string", "format": "uuid" },
        "addressId": { "type": "string", "format": "uuid" },
        "items": { "type": "array", "minItems": 1 },
        "totalPaisa": { "type": "integer", "minimum": 1 },
        "commissionPaisa": { "type": "integer", "minimum": 0 },
        "currency": { "const": "PKR" },
        "paymentMethod": { "const": "cod" }
      }, "additionalProperties": false }
    } }
  ]
}
