{
  "name": "@khana-karlo/v2",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev:gateway": "pnpm --filter @khana/api-gateway dev",
    "check": "pnpm -r check",
    "test": "pnpm --filter @khana/service-kit test && pnpm --filter @khana/payment test && pnpm --filter @khana/mobile test",
    "test:integration": "node scripts/test-foundation.mjs",
    "clients:generate": "node scripts/generate-customer-client.mjs",
    "clients:check": "node scripts/generate-customer-client.mjs --check",
    "mock:customer": "node scripts/mock-customer.mjs",
    "lint": "pnpm -r lint && eslint scripts",
    "contracts:check": "node scripts/validate-contracts.mjs",
    "migrate": "node --env-file=.env scripts/migrate-service.mjs",
    "compose:up": "docker compose -f infrastructure/local/docker-compose.yml up -d",
    "compose:apps:up": "docker compose -f infrastructure/local/docker-compose.yml --profile apps up -d --build",
    "compose:logs": "docker compose -f infrastructure/local/docker-compose.yml --profile apps logs -f",
    "compose:down": "docker compose -f infrastructure/local/docker-compose.yml --profile apps down"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.3.3",
    "pg": "^8.13.0",
    "typescript": "~6.0.3",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.48.0",
    "vitest": "^2.1.9"
  }
}
